{
  "name": "review-seal",
  "version": "0.1.1",
  "description": "Claude Code plugin, pre-commit hook and GitHub Action. A separate Claude Code session reviews changed files against your checklist. Commits wait until the review is current.",
  "type": "module",
  "bin": { "review-seal": "bin/review-seal.js" },
  "files": [
    "bin/", "lib/", ".claude-plugin/", "hooks/", "commands/",
    "action.yml", ".pre-commit-hooks.yaml", "README.md", "LICENSE", "SECURITY.md", "docs/reference.md"
  ],
  "engines": { "node": ">=20" },
  "scripts": { "test": "node --test test/*.test.js" },
  "keywords": ["claude-code", "claude-code-plugin", "claude", "review", "code-review", "pre-commit", "git-hooks", "github-action", "ai-agents", "audit"],
  "author": "oo-pibe",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/oo-pibe/review-seal.git" },
  "homepage": "https://github.com/oo-pibe/review-seal#readme",
  "bugs": { "url": "https://github.com/oo-pibe/review-seal/issues" }
}
