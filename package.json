  ],
  "engines": { "node": ">=20" },
  "scripts": { "test": "node --test test/*.test.js" },
  "keywords": ["claude-code", "claude-code-plugin", "review", "pre-commit", "git-hooks", "ai-agents", "audit"],
  "author": "oo-pibe",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/oo-pibe/review-seal.git" }
